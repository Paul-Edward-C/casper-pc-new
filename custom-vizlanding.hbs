    font-size: clamp(2rem, 2.6vw, 2.6rem); margin: 0 0 4px; letter-spacing: .01em;
  }
  .viz-item p { margin: 0; color: #3C444B; font-size: 1.55rem; max-width: 64ch; }
  .viz-item .go { font-size: 1.2rem; letter-spacing: .14em; text-transform: uppercase; color: var(--viz-green); font-weight: 600; white-space: nowrap; }
  .viz-item.lead { background: var(--viz-wash); border-left: 4px solid var(--viz-green); padding-left: 18px; }

