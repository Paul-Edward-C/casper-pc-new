{{!< default}}

{{!--
  Data and visualisations.

  Coverage figures are fetched live from the data API's open /stats endpoint
  rather than typed in. The previous version of this page advertised "246,000+"
  series, which had drifted a long way from reality; anything hard-coded here
  goes stale the same way. The numbers in the markup are only a fallback for a
  reader with JavaScript off or the API unreachable -- refresh them if you ever
  see them being served.
--}}

<style>
  :root {
    --viz-green: var(--ghost-accent-color, #204D39);
    --viz-bone: #F0EDE4;
    --viz-ink: #15171A;
    --viz-mid: #738a94;
    --viz-border: #e1e1e1;
    --viz-wash: #e5eff5;
  }

  /* ---- standfirst, on the banner green ---- */
  .viz-lede {
    background: var(--viz-green);
    color: var(--viz-bone);
    padding: 0 max(4vmin, 20px) clamp(30px, 5vw, 58px);
    margin-top: -1px;                      /* close the seam under the banner */
    text-align: center;
  }
  .viz-lede-inner { max-width: 900px; margin: 0 auto; }
  .viz-lede p {
    margin: 0;
    font-size: clamp(1.7rem, 2.1vw, 2.1rem);
    line-height: 1.55;
    opacity: .95;
  }
  .viz-lede .viz-count {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 700;
    font-size: 1.3em;
    letter-spacing: .01em;
  }
  .viz-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 26px; }
  .viz-btn {
    display: inline-block; font-size: 1.5rem; font-weight: 600; padding: 12px 24px;
    border-radius: 4px; text-decoration: none; letter-spacing: .04em; transition: opacity .15s;
  }
  .viz-btn.solid { background: var(--viz-bone); color: var(--viz-green); }
  .viz-btn.ghost { color: var(--viz-bone); border: 1px solid rgba(240,237,228,.45); }
  .viz-btn:hover { opacity: .85; }

  /* ---- sections ---- */
  .viz-section { max-width: 1200px; margin: 0 auto; padding: clamp(40px, 5vw, 68px) max(4vmin, 20px); }
  .viz-section + .viz-section { border-top: 1px solid var(--viz-border); }
  .viz-kicker {
    font-size: 1.2rem; letter-spacing: .24em; text-transform: uppercase;
    color: var(--viz-mid); margin: 0 0 14px;
  }
  .viz-section h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 700; letter-spacing: .01em; margin: 0;
    font-size: clamp(2.8rem, 4vw, 4.4rem); line-height: 1.1;
  }
  .viz-sub { color: #3C444B; max-width: 62ch; margin: 14px 0 0; font-size: 1.7rem; }

  /* ---- coverage tables ---- */
  .viz-split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 50px); margin-top: 34px; }
  @media (max-width: 820px) { .viz-split { grid-template-columns: 1fr; gap: 26px; } }
  .viz-tbl { width: 100%; border-collapse: collapse; font-size: 1.6rem; }
  .viz-tbl caption {
    text-align: left; font-size: 1.2rem; letter-spacing: .24em; text-transform: uppercase;
    color: var(--viz-mid); padding-bottom: 10px;
  }
  .viz-tbl td { padding: 10px 0; border-bottom: 1px solid var(--viz-border); }
  .viz-tbl td:last-child {
    text-align: right; font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 700; font-size: 2rem; color: var(--viz-ink);
  }
  .viz-tbl tr:last-child td { border-bottom: 0; }

  /* ---- API ---- */
  .viz-pre {
    background: var(--viz-ink); color: #E4E7E4; border-radius: 5px; padding: 18px 20px;
    margin: 0; overflow-x: auto; font-family: Menlo, Courier, monospace;
    font-size: 1.25rem; line-height: 1.7;
  }
  .viz-ep code {
    display: block; font-family: Menlo, Courier, monospace; font-size: 1.3rem;
    background: #f1f1f1; color: var(--viz-ink); padding: 7px 11px;
    border-radius: 4px; margin-bottom: 8px; overflow-x: auto; white-space: nowrap;
  }

  /* ---- access tiers ---- */
  .viz-tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 32px; }
  @media (max-width: 900px) { .viz-tiers { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .viz-tiers { grid-template-columns: 1fr; } }
  .viz-tier {
    border: 1px solid var(--viz-border); border-radius: 5px; padding: 20px 18px; background: #fff;
  }
  .viz-tier.feature { border-color: var(--viz-green); border-top: 4px solid var(--viz-green); background: var(--viz-wash); }
  .viz-tier h3 {
    font-family: "Cormorant Garamond", Georgia, serif; font-weight: 700;
    font-size: 2.2rem; margin: 0 0 12px; color: var(--viz-ink);
  }
  .viz-tier ul {
    list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid var(--viz-border);
    font-size: 1.5rem; color: #3C444B;
  }
  .viz-tier li { margin-bottom: 7px; }
  .viz-tier li b { color: var(--viz-ink); }

  /* ---- tool cards (existing pattern, kept) ---- */
  .dashboard-cards {
    display: grid; grid-template-columns: 1fr; gap: 2rem; margin: 2rem auto 0;
    max-width: 1200px; width: 100%;
  }
  @media (min-width: 900px) { .dashboard-cards { grid-template-columns: repeat(3, 1fr); } }
  .dashboard-card {
    border: 1px solid var(--viz-border); border-radius: 8px; overflow: hidden;
    transition: transform .2s, box-shadow .2s; text-decoration: none; color: inherit;
    display: flex; flex-direction: column;
  }
  .dashboard-card:hover { transform: translateY(-4px); box-shadow: 0 8px 16px rgba(0,0,0,.1); }
  .dashboard-card img { width: 100%; height: auto; display: block; }
  .dashboard-card-content { padding: 1.5rem; margin-top: auto; }
  .dashboard-card h3 { margin: 0 0 .5rem; font-size: 2.4rem; }
  .dashboard-card p { margin: 0; color: #666; font-size: 1.6rem; }

  .menu-item {
    display: inline-block; margin: 10px 5px; font-size: 16px; color: #fff;
    text-decoration: none; padding: 2px 15px; border-radius: 5px;
    background-color: var(--viz-green); transition: background-color .3s ease;
    font-weight: bold; text-align: center; width: 150px;
  }
  .menu-item:hover { opacity: .8; }
  .responsive-iframe { width: 100%; min-height: 1000px; border: none; }
</style>

