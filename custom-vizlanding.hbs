<script>
/* Coverage figures, read from the API rather than typed in. The markup above
   carries the last known values so the page still reads correctly with
   JavaScript off; this replaces them with whatever the API is serving now. */
(function () {
  var API = "https://data-api-production-74e0.up.railway.app";
  var NAMES = { cn: "China", jp: "Japan", kr: "Korea", tw: "Taiwan", region: "Region &amp; cross-country" };
  var FREQ = { m: "Monthly", q: "Quarterly", a: "Annual" };
  var n = function (v) { return v.toLocaleString("en-GB"); };

  fetch(API + "/stats").then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
    if (!d || !d.total_series) return;

    var el = document.getElementById("viz-series");
    if (el) el.textContent = n(d.total_series);
    var pts = document.getElementById("viz-points");
    if (pts) pts.textContent = n(d.total_data_points);

    var rows = function (obj, labels) {
      return Object.keys(obj).sort(function (a, b) { return obj[b] - obj[a]; })
        .map(function (k) {
          return "<tr><td>" + (labels[k] || k) + "</td><td>" + n(obj[k]) + "</td></tr>";
        }).join("");
    };

    var c = document.getElementById("viz-by-country");
    if (c && d.by_country) c.innerHTML = rows(d.by_country, NAMES);

    var f = document.getElementById("viz-by-freq");
    if (f && d.by_frequency) {
      f.innerHTML = rows(d.by_frequency, FREQ) +
        '<tr><td>Data points</td><td>' + n(d.total_data_points) + "</td></tr>" +
        "<tr><td>Span</td><td>1900&ndash;2100</td></tr>";
    }
  }).catch(function () { /* keep the fallback figures */ });
})();
</script>
