  .dashboard-card img { width: 100%; height: auto; display: block; }
  .dashboard-card-content { padding: 1.5rem; margin-top: auto; }
  .dashboard-card h3 { margin: 0 0 .5rem; font-size: 2.4rem; }
  .dashboard-card p { margin: 0; color: #666; font-size: 1.6rem; }

  .menu-item {
    display: inline-block; margin: 10px 5px; font-size: 16px; color: #fff;
    text-decoration: none; padding: 2px 15px; border-radius: 5px;
    background-color: var(--viz-green); transition: background-color .3s ease;
    font-weight: bold; text-align: center; width: 150px;
  }
  .menu-item:hover { opacity: .8; }
  .responsive-iframe { width: 100%; min-height: 1000px; border: none; }
</style>

