{{!< default}}
{{!-- The tag above means: insert everything in this file
into the {body} of the default.hbs template --}}

{{!-- 
NO CONFIGURATION NEEDED!
This template automatically detects the country from the page slug.
Your page slugs should be: jp, cn, kr, tw, hk, sg, or all

To add categories for a country, just edit the sections below for that country code.
--}}

{{!-- Header with country name over feature image --}}
{{#post}}{{> "page-banner"}}{{/post}}

<div id="site-main" class="site-main outer">
    <main id="site-main" class="site-main outer">
        <header class="article-header gh-canvas">
            {{#if feature_image}}
            <figure class="article-image">
                <img
                    srcset="{{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 600w,
                            {{img_url feature_image size="l"}} 1000w,
                            {{img_url feature_image size="xl"}} 2000w"
                    sizes="(min-width: 1400px) 1400px, 92vw"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
            {{/if}}
        </header>

        <div class="outer">
            {{#page}}
            <article class="post-full {{post_class}} no-image">
                <section class="post-full-content">
                    <div class="post-content">
                        <h2 class="post-title latest-title">Articles</h2>
                    </div>
                </section>
            </article>
            {{/page}}
        </div>

{{#post}}
{{#match slug "tw"}}{{> "country-posts" tagfilter="tag:hash-tw"}}{{/match}}
{{#match slug "cn"}}{{> "country-posts" tagfilter="tag:hash-cn"}}{{/match}}
{{#match slug "jp"}}{{> "country-posts" tagfilter="tag:hash-jp"}}{{/match}}
{{#match slug "kr"}}{{> "country-posts" tagfilter="tag:hash-kr"}}{{/match}}
{{#match slug "all"}}{{> "country-posts" tagfilter="tag:hash-all"}}{{/match}}
{{/post}}

<div class="myBTNdiv">
  <a href="https://www.eastasiaecon.com/cycle" class="myButton">Article archive</a>
</div>


   <style>

        .menu-item, .myButton {
            display: inline-block;
            margin: 10px 5px;
            font-size: 16px;
            color: #ffffff;
            text-decoration: none;
            padding: 2px 15px;
            border-radius: 5px;
            font-family: -apple-system,BlinkMacSystemFont,"Segoe UI","Roboto","Oxygen","Ubuntu","Cantarell","Fira Sans","Droid Sans","Helvetica Neue",sans-serif;
            background-color: #104b1f;
            transition: background-color 0.3s ease;
            font-weight: bold;
            text-align: center;
            width: 150px;
        }

        .menu-item:hover, .myButton:hover {
            background-color: rgba(16, 75, 31, 0.7);
        }
        
        body {
            overflow-x: auto;
        }

        .responsive-iframe {
            width: 100%;
            height: auto;
            min-height: 1000px;
        }

        .myBTNdiv {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .menu-item {
            margin: 0 10px;
        }
        #charts {
            text-align: center;
            margin-bottom: 20px;
        }

        .myButton {
        width: 200px;
        }

        .post-label {
        display: inline-block;
        padding: 5px 10px;
        font-size: 14px;
        font-weight: bold;
        background-color: #ffffff;
        border: 2px solid #104b1f;
        border-radius: 5px;
        color: #104b1f;
        text-align: center;
        margin: 5px 0;
        }

        /* Chart pack nav: underline tabs, not buttons.
           Fixed 150px green blocks did not scale - the region page carries 15 packs, about
           2,400px of chrome wrapping onto three rows. These size to their label, sit in one
           sticky row, and scroll sideways when they do not fit.
           The bar is painted #F0EDE4 to match the body background (set !important in the
           theme css), so what you see is a hairline rule rather than a white slab.
           Colours carry !important because the shared .menu-item/.myButton rule above, and
           Casper's own link styling, otherwise win the cascade and leave green on green. */
        #chart-menu {
            position: sticky;
            top: 0;
            z-index: 20;
            display: flex;
            flex-wrap: nowrap;
            justify-content: center;
            justify-content: safe center;   /* falls back to start when it overflows */
            gap: 26px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding: 10px 16px 0;
            margin-bottom: 18px;
            background: #F0EDE4;
            border-bottom: 1px solid rgba(16, 75, 31, 0.18);
        }
        #chart-menu::-webkit-scrollbar { display: none; }

        #chart-menu .menu-item {
            flex: 0 0 auto;
            width: auto !important;
            margin: 0 !important;
            padding: 6px 0 !important;
            font-size: 15px;
            font-weight: 600;
            border-radius: 0 !important;
            background: none !important;
            background-color: transparent !important;
            color: rgba(16, 75, 31, 0.6) !important;
            border-bottom: 2px solid transparent;
            white-space: nowrap;
            transition: color 0.15s ease, border-color 0.15s ease;
        }
        #chart-menu .menu-item:hover {
            color: #104b1f !important;
            border-bottom-color: rgba(16, 75, 31, 0.35);
        }
        #chart-menu .menu-item.is-active {
            color: #104b1f !important;
            border-bottom-color: #104b1f;
        }

        /* Dark mode: the theme switches body to --color-darkmode, so follow it. */
        @media (prefers-color-scheme: dark) {
            #chart-menu {
                background: var(--color-darkmode, #151719);
                border-bottom-color: rgba(255, 255, 255, 0.18);
            }
            #chart-menu .menu-item { color: rgba(255, 255, 255, 0.6) !important; }
            #chart-menu .menu-item:hover,
            #chart-menu .menu-item.is-active { color: #ffffff !important; }
            #chart-menu .menu-item.is-active { border-bottom-color: #ffffff; }
        }
    </style>


</main>
</div>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Charts</title>
</head>
<body>

<div id="site-main" class="site-main outer">
</div>

<div id="charts" data-slug="{{slug}}">
    <a href="#charts"></a><br>
    <h2 class="post-title latest-title">Charts</h2>
    <div id="chart-menu"></div>
</div>

<div id="chart-sections"></div>

{{!-- Upgrade CTA shown to members without a qualifying tier --}}
<div id="upgrade-cta" style="display: none; text-align: center; padding: 40px 20px; background-color: #f5f5f5; border-radius: 8px; margin: 20px auto; max-width: 600px;">
    <h3>Additional Charts Available for Subscribers</h3>
    <p>Access all {{title}} economic charts with an East Asia or Daily + Data subscription.</p>
    <a href="#/portal/account/plans" class="myButton" style="display: inline-block; margin-top: 15px;">Upgrade</a>
</div>

{{!-- ==========================================================================
     ONE template for every country page. The page SLUG is the country code
     (jp / cn / kr / tw / all  -> the "all" page uses the region_* charts).
     PACKS below is the SINGLE list of all possible chart packs; each is shown
     only if its chart actually exists on netlify (probed live). The live probe
     needs Access-Control-Allow-Origin on the netlify charts site -> add a
     `_headers` file there ( /*  Access-Control-Allow-Origin: * ) and deploy it,
     otherwise every probe fails (CORS) and no charts render.
     'consumer' is public; every other pack is gated to East Asia / Daily + Data.
     ========================================================================== --}}
<script>
(function () {
    var NETLIFY = "https://main--beautiful-dolphin-db8ab2.netlify.app/charts";

    var slug = (document.getElementById('charts').dataset.slug
            || location.pathname.split('/').filter(Boolean)[0] || "").trim().toLowerCase();
    var cc   = (slug === 'all') ? 'region' : slug;   // the "all" page uses the region charts

    // --- what packs exist comes from the manifest, not from a list kept in here ---------
    // charts/index.json is written by netifly/build_chart_index.py, which scans the chart
    // files on disk. Publishing <cc>_<pack>.html and re-running it is all that is needed for
    // a new pack to appear here - no theme edit. Replaces the old hardcoded PACKS list, which
    // silently ignored anything not written into it (kr_fiscal sat unused for months), and
    // replaces one HEAD probe per pack per page load with a single request.
    var FALLBACK = ['consumer', 'exports', 'prices', 'corp_px', 'surveys', 'markets',
                    'flows', 'labour', 'macro', 'money', 'fiscal', 'industry'];

    // 'consumer' is free; everything else needs a qualifying subscription tier. Note a newly
    // published pack is gated by default - add it here to make it public.
    var PUBLIC = { consumer: true };
    var allowedTiers = ['East Asia', 'Daily + Data'];
    var memberTiers = [{{#if @member}}{{#foreach @member.subscriptions}}"{{tier.name}}"{{#unless @last}}, {{/unless}}{{/foreach}}{{/if}}];
    var hasAccess = memberTiers.some(function (t) { return allowedTiers.indexOf(t) !== -1; });

    function titleCase(sl) {
        return sl.replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
    }
    function packUrl(slug) { return NETLIFY + '/' + cc + '/' + cc + '_' + slug; }

    function sectionHtml(slug, label) {
        return '<div id="pack_' + slug + '">' +
                 '<a id="pack_' + slug + '_anchor"></a>' +
                 '<h2>' + label + '</h2>' +
                 '<figure class="kg-image-card kg-width-full">' +
                   '<iframe src="' + packUrl(slug) + '" class="responsive-iframe" width="100%" style="height: auto;" loading="lazy"></iframe>' +
                 '</figure>' +
               '</div>';
    }

    if (!cc) { return; }
    var menu = document.getElementById('chart-menu');
    var sections = document.getElementById('chart-sections');
    var cta = document.getElementById('upgrade-cta');

    function render(slugs, labels) {
        var gatedExists = 0;
        slugs.forEach(function (slug) {
            var isPublic = !!PUBLIC[slug];
            if (!isPublic) {
                gatedExists++;
                if (!hasAccess) { return; }            // gated + no access -> skip (CTA shown)
            }
            var label = (labels && labels[slug]) || titleCase(slug);
            var a = document.createElement('a');
            a.href = '#pack_' + slug + '_anchor';
            a.className = 'menu-item';
            a.dataset.slug = slug;
            a.textContent = label;
            menu.appendChild(a);
            sections.insertAdjacentHTML('beforeend', sectionHtml(slug, label));
        });
        if (gatedExists > 0 && !hasAccess) { cta.style.display = 'block'; }
        spy();
    }

    // Highlight the pack currently in view, and keep it scrolled into sight in the nav.
    function spy() {
        if (!('IntersectionObserver' in window)) { return; }
        var items = menu.querySelectorAll('.menu-item');
        if (!items.length) { return; }
        var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (!e.isIntersecting) { return; }
                var slug = e.target.id.replace('pack_', '');
                items.forEach(function (a) {
                    var on = a.dataset.slug === slug;
                    a.classList.toggle('is-active', on);
                    if (on && menu.scrollWidth > menu.clientWidth) {
                        a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
                    }
                });
            });
        }, { rootMargin: '-15% 0px -75% 0px' });
        sections.querySelectorAll('[id^="pack_"]').forEach(function (el) { obs.observe(el); });
    }

    fetch(NETLIFY + '/index.json', { cache: 'no-cache' })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (m) {
            render(((m.countries || {})[cc] || []), m.labels || {});
        })
        .catch(function () {
            // manifest missing or not yet deployed: fall back to the core packs so the page
            // is not blank, and let a 404 iframe be the only cost of a pack that is absent.
            render(FALLBACK, null);
        });
})();
</script>

</body>
</html>
