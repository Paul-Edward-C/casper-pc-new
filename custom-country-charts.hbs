{{!< default}}
{{!--
  LIVE DASHBOARD - /jp/ /kr/ /tw/ /cn/ and /all/ (Region), and their topic pages /jp/prices/ ... (routes.yaml).
  The pages /jp/ etc. already use this template; the topic pages are static routes onto it.

  Who sees what is decided by the EAE data API (dashboards.py in eae-data-api), from the reader's Ghost plan:
    Daily (and the legacy Individual plan)  every front page, incl. Region; notes open as excerpt + charts
    Daily + Data                            the same plus every topic page
    East Asia                               everything; notes open as the full post
  The page asks Ghost for the reader's member token (/members/api/session, same origin), sends it to the API and
  draws what comes back with dashboard.js from the chart site (window.EAEDash). Nothing gated is in this file.
  Markup below = the dashboard's own (chartsite/scripts/build_dashboard.py PAGE); styles = dashboard-live.css,
  scoped under .eae-dash so they cannot touch the rest of the theme.
  The previous template (banner, post list, chart-pack iframes) is in ghost/theme_backups/.
--}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap">
<link rel="stylesheet" href="https://charts.eastasiaecon.com/assets/dashboard-live.css">
<style>
  .eae-dash { padding: 0 0 40px; }
  .eae-dash .dash-msg { max-width: 640px; margin: 60px auto; padding: 28px 24px; text-align: center; border: 1px solid var(--border, #e3e0d6); border-radius: 8px; }
  .eae-dash .dash-msg h2 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 30.4px; margin: 0 0 10px; }
  .eae-dash .dash-msg p { margin: 8px 0; }
  .eae-dash .dash-msg .btns { margin-top: 18px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .eae-dash .dash-msg .btns a { display: inline-block; padding: 8px 18px; border-radius: 5px; background: #104b1f; color: #fff; text-decoration: none; font-weight: 600; }
  .eae-dash .dash-msg .btns a.alt { background: transparent; color: #104b1f; border: 1px solid #104b1f; }
</style>
{{!-- The page header from the previous version: page name in the big slot, the EAE mark and wordmark on the right
     (partials/page-banner.hbs, styles in assets/css/home.css). Front pages render it from their Ghost page; the topic
     routes have no page behind them, so the script below writes the economy's name in. --}}
{{#if post}}{{#post}}{{> "page-banner"}}{{/post}}{{else}}{{> "page-banner" title=" "}}{{/if}}
<div class="eae-dash" id="eae-dash">
  <p class="dash-msg" id="dash-loading">Loading the dashboard…</p>
  <div class="dash-msg" id="dash-gate" hidden></div>
  <div id="dash-app" hidden>
<nav class="d-nav" id="d-nav" aria-label="Dashboard pages" hidden><div class="wrap"><ul id="d-menu"></ul></div></nav>
<main class="wrap dash">
  <h1 id="d-title"></h1>
  <p class="lede" id="d-intro"></p>
  <p class="stamp" id="d-stamp"></p>
  <div id="notes-wrap" hidden>
    <h2 class="band">Releases and notes <small id="n-count"></small>
      <button class="link-btn n-toggle" type="button" id="n-toggle" aria-expanded="true" aria-controls="n-body">Hide</button></h2>
    <div class="n-strip" id="n-strip" hidden></div>
    <div class="n-rel" id="n-body">
      <div class="n-feed" id="n-feed"><p class="n-msg">Loading notes…</p></div>
      <aside class="n-side">
        <div class="n-panel"><h4>Today's releases</h4><ul id="n-cal"></ul></div>
        <div class="n-panel"><h4>Coming up</h4><ul id="n-next"></ul></div>
        <p class="n-hint" id="n-hint"></p>
      </aside>
    </div>
    <h2 class="band">Latest notes <small>Whatever their age. Quick reactions are only under Releases and notes.</small></h2>
    <p class="n-sub">Cycle</p>
    <div class="n-latest" id="n-latest"><p class="n-msg">Loading notes…</p></div>
    <p class="n-sub">Thematic</p>
    <div class="n-latest" id="n-other"><p class="n-msg">Loading notes…</p></div>
    <p class="n-sub">Latest outlook and slide pack</p>
    <div class="n-latest n-pair" id="n-pair"><p class="n-msg">Loading notes…</p></div>
  </div>
  <div id="sum-wrap" hidden>
    <h2 class="band">Summary <small>From the latest notes on this data, newest first</small></h2>
    <div class="sum" id="sum"><p class="n-msg">Loading notes…</p></div>
  </div>
  <h2 class="band" id="tiles-head">Headline indicators</h2>
  <div class="tiles" id="tiles"></div>
  <div id="sections"></div>
</main>
<div class="modal" id="modal" hidden>
  <div class="box chart-card"><button class="link-btn close" type="button" id="modal-close">Close</button>
    <div id="modal-card"></div></div>
</div>
<footer class="site-footer"><div class="wrap" id="d-foot"></div></footer>
  </div>
</div>
<script src="https://charts.eastasiaecon.com/assets/vendor/echarts.custom.js"></script>
<script src="https://charts.eastasiaecon.com/assets/charts.js"></script>
<script src="https://charts.eastasiaecon.com/assets/dashboard.js"></script>
<script>
(function () {
  var API = "https://data-api-production-74e0.up.railway.app";
  var ASSETS = "https://charts.eastasiaecon.com/assets/";
  var NAMES = { jp: "Japan", kr: "Korea", tw: "Taiwan", cn: "China", region: "Region" };
  var parts = location.pathname.split("/").filter(Boolean);
  var base = parts[0] || "";
  var cc = base === "all" ? "region" : base;
  var page = parts[1] || "index";
  var $ = function (id) { return document.getElementById(id); };
  function navHref(slug) { return "/" + base + "/" + (slug === "index" ? "" : slug + "/"); }
  function show(id) { ["dash-loading", "dash-gate", "dash-app"].forEach(function (x) { $(x).hidden = x !== id; }); }

  // Locked: not signed in (401) -> sign in / plans; signed in on too low a plan (403) -> upgrade. Same split as the API.
  function gate(status, d) {
    var name = NAMES[cc] || "This";
    var need = d.required_label || "a subscription";
    var html = status === 401
      ? '<h2>The ' + name + ' dashboard is for subscribers</h2>' +
        '<p>Headline data, the latest releases and notes, and the charts behind them. ' +
        (page === "index" ? "The front pages come with the Daily plan." : "Topic pages come with the " + need + " plan.") + '</p>' +
        '<div class="btns"><a href="#/portal/signin">Sign in</a><a class="alt" href="#/portal/signup">See the plans</a></div>'
      : '<h2>This page is on the ' + need + ' plan</h2>' +
        '<p>' + (page === "index" ? "The dashboards come with the Daily plan and above."
                 : "Topic pages come with Daily + Data and East Asia. Your plan includes the " + name + ' <a href="' + navHref("index") + '">front page</a>.') + '</p>' +
        '<div class="btns"><a href="#/portal/account/plans">Upgrade</a></div>';
    $("dash-gate").innerHTML = html;
    show("dash-gate");
  }

  var pbName = document.querySelector(".page-banner .pb-name");
  if (pbName && !pbName.textContent.trim()) pbName.textContent = NAMES[cc] || "";
  if (!NAMES[cc]) { $("dash-loading").textContent = "No dashboard here."; return; }
  fetch("/members/api/session", { credentials: "include" })
    .then(function (r) { return r.ok ? r.text() : ""; })
    .catch(function () { return ""; })
    .then(function (tok) {
      tok = (tok || "").trim();
      var headers = tok ? { Authorization: "Bearer " + tok } : {};
      return fetch(API + "/dashboards/" + cc + "/" + encodeURIComponent(page), { headers: headers, credentials: "omit" })
        .then(function (r) {
          if (r.status === 401 || r.status === 403) {
            return r.json().catch(function () { return {}; }).then(function (b) { gate(r.status, (b && b.detail) || {}); return null; });
          }
          if (r.status === 404) { $("dash-loading").textContent = "There is no such dashboard page."; return null; }
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(function (j) {
          if (!j) return;
          var full = j.your_access === "full";
          show("dash-app");
          document.title = j.data.title + " — East Asia Econ";
          window.EAEDash(j.data, {
            theme: "light", assets: ASSETS, navHref: navHref,
            // Daily and Daily + Data: a note opens here as its excerpt and charts; East Asia readers go to the post
            openNote: full ? null : function (id) {
              return fetch(API + "/notes/" + id, { headers: headers, credentials: "omit" })
                .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
                .then(function (x) { return x.note; });
            },
            upgradeHtml: full ? "" : 'The full note is on the East Asia plan &middot; <a href="#/portal/account/plans">Upgrade</a>'
          });
        });
    })
    .catch(function () { $("dash-loading").textContent = "The dashboard couldn't load just now. Please try again in a minute."; show("dash-loading"); });
})();
</script>
