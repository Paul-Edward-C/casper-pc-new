{{!< default}}
{{!-- The tag above means: insert everything in this file
into the {body} of the default.hbs template --}}

{{!-- ==========================================================================
     Charts — the coverage matrix (every economy against every pack) from
     charts.eastasiaecon.com, embedded as SVG/HTML in this page's own DOM. No
     iframe, so it inherits the page width, resizes, prints and is indexable.

     Header lockup is the same as custom-country-charts.hbs: the page banner,
     then an optional feature image, then a section heading.

     The embed reads three attributes:
       data-eae-width="full"   break out of the 720px post column
       data-eae-title="off"    suppress the embed's own "Chart packs" <h2>,
                               because this template prints it as the section
                               heading instead — otherwise it appears twice
       data-eae-intro="..."    replaces the default blurb

     NOTE: this template does not render {{content}}, so anything in the page
     body in Ghost admin is ignored. That is deliberate — the old HTML card can
     stay where it is without producing a second copy of the table.
     ========================================================================== --}}

{{!-- Header with page name over feature image --}}
{{#post}}{{> "page-banner" title="Charts"}}{{/post}}

<div class="site-main outer">
    <main id="site-main" class="site-main outer">
        <header class="article-header gh-canvas">
            {{#if feature_image}}
            <figure class="article-image">
                <img
                    srcset="{{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 600w,
                            {{img_url feature_image size="l"}} 1000w,
                            {{img_url feature_image size="xl"}} 2000w"
                    sizes="(min-width: 1400px) 1400px, 92vw"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
            {{/if}}
        </header>

        <div class="outer">
            {{#page}}
            <article class="post-full {{post_class}} no-image">
                <section class="post-full-content">
                    <div class="post-content">
                        <p id="eae-back" hidden><a href="/charts/">&larr; All chart packs</a></p>
                        <h2 class="post-title latest-title" id="eae-heading">Chart packs</h2>
                    </div>
                </section>
            </article>
            {{/page}}
        </div>

        {{!-- .gh-content.gh-canvas is the grid the embed's width breakout is
              measured against; without it data-eae-width has nothing to escape
              from and the table renders at whatever width this container is. --}}
        <section class="gh-content gh-canvas">
            {{!-- This page does two jobs. Plain /charts/ shows the coverage table;
                  /charts/?p=cn-consumer shows that one pack instead. Every cell in
                  the table links to the second form (data-eae-link). Packs open
                  here, on a Ghost page, because gated packs are fetched from the
                  data API with the reader's Ghost login, which the chart site's
                  own domain cannot see. --}}
            {{!-- Placed on the theme's own grid rather than with data-eae-width:
                  the embed's "full" sizes itself at 96vw but keeps the narrow
                  main column's start, so the table sat to the right of the
                  heading and ran off the page. wide-start/wide-end is the column
                  the "Chart packs" heading uses. --}}
            <div id="eae-slot"
                 style="grid-column: wide-start / wide-end"
                 data-eae-index
                 data-eae-title="off"
                 data-eae-link="/charts/?p={economy}-{pack}"
                 data-eae-intro="Every economy, every pack. Coverage differs by economy because national statistics offices publish different things."></div>
            {{!-- Runs before embed.js (which is async, so it executes after this
                  inline script): with ?p= it turns the table slot into a pack. --}}
            <script>
            (function () {
                var id = new URLSearchParams(location.search).get("p") || "";
                // economy-pack, both plain lowercase codes; anything else is not
                // a pack id, is never written into the page, and leaves the table.
                var m = /^([a-z]+)-([a-z]+)$/.exec(id);
                if (!m) return;
                var slot = document.getElementById("eae-slot");
                var el = document.createElement("div");
                // No width override: the pack sits in the post column, the same
                // width a chart has in any Ghost post, so it is not stretched.
                el.setAttribute("data-eae-pack", m[1] + "/" + m[2]);
                slot.parentNode.replaceChild(el, slot);
                document.getElementById("eae-back").hidden = false;

                // Name the pack once embed.js has loaded the site manifest.
                var tries = 0;
                (function title() {
                    var site = window.SITE;
                    if (!site || !site.economies) {
                        if (++tries < 50) setTimeout(title, 200);
                        return;
                    }
                    var ec = site.economies.filter(function (e) { return e.code === m[1]; })[0];
                    var pk = site.packs.filter(function (p) { return p.code === m[2]; })[0];
                    if (ec && pk) {
                        document.getElementById("eae-heading").textContent = ec.name + " \u2014 " + pk.name;
                        document.title = ec.name + " " + pk.name + " \u2014 " + document.title;
                    }
                })();
            })();
            </script>
            <script src="https://charts.eastasiaecon.com/assets/embed.js?v=6" async></script>
        </section>
    </main>
</div>
