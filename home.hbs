{{!< default}}
{{!--
  HOME PAGE - draft of 15 Nov 2026 for Paul to react to (the previous version is in ghost/theme_backups/).
  Order: banner; who we are + the right buttons for the reader; the five live dashboards; the latest analysis
  (Cycle / Outlook / Thematic, quick reactions excluded as before); a row with the latest East Asia Today, the latest
  East Asia in Four Charts and the latest quick reactions; about.
  The old 'Summary charts' iframe (the retired Netlify chart site) is gone: the dashboards replace it.
  Sizes are px, not rem: Casper sets html { font-size: 62.5% }.
--}}

<div class="home-banner">
    <div class="home-banner-inner">
        <div class="hb-word">
            <span class="hb-title">East Asia Econ</span>
            <span class="hb-sub">Paul Cavey</span>
        </div>
        <img class="hb-mark" src="{{asset "images/logo_mark.png"}}" alt="" aria-hidden="true" />
        <div class="hb-tag">
            <span>Macro.</span>
            <span>Markets.</span>
            <span>Strategy.</span>
        </div>
    </div>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap">
<style>
  .eae-home { max-width: 1180px; margin: 0 auto; padding: 28px 24px 64px; font-size: 16px; line-height: 1.55; color: #1d2a24; }
  .eae-home h2 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 32px; font-weight: 600; color: #104b1f; margin: 48px 0 4px; line-height: 1.2; }
  .eae-home h2 a { color: inherit; text-decoration: none; }
  .eae-home .more { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 14px; font-weight: 600; margin-left: 12px; color: #104b1f; }
  .eae-home .sub { color: #66706a; font-size: 15px; margin: 0 0 18px; max-width: 760px; }
  .eae-home .intro { display: flex; gap: 28px; align-items: center; justify-content: space-between; flex-wrap: wrap; border-bottom: 1px solid #e3e0d6; padding-bottom: 24px; }
  .eae-home .intro p { font-size: 19px; max-width: 720px; margin: 0; }
  .eae-home .btn { display: inline-block; padding: 9px 20px; border-radius: 5px; background: #104b1f; color: #fff !important; text-decoration: none; font-weight: 600; font-size: 15px; margin: 4px 8px 4px 0; white-space: nowrap; }
  .eae-home .btn.alt { background: transparent; color: #104b1f !important; border: 1px solid #104b1f; }

  .eae-home .dashes { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .eae-home .dash { display: block; border: 1px solid #e3e0d6; border-top: 4px solid #104b1f; border-radius: 6px; padding: 14px 16px 16px; background: #fff; color: inherit; text-decoration: none; transition: box-shadow .15s; }
  .eae-home .dash:hover { box-shadow: 0 2px 10px rgba(16, 75, 31, .15); }
  .eae-home .dash b { display: block; font-family: "Cormorant Garamond", Georgia, serif; font-size: 24px; font-weight: 600; color: #104b1f; }
  .eae-home .dash span { display: block; font-size: 14px; color: #3b4741; line-height: 1.45; margin-top: 4px; }
  .eae-home .dash.region { border-top-color: #b8862b; }

  .eae-home .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .eae-home .card { border: 1px solid #e3e0d6; border-radius: 8px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
  .eae-home .card a { color: inherit; text-decoration: none; }
  .eae-home .card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; border-bottom: 1px solid #eee; }
  .eae-home .card .t { padding: 12px 16px 16px; }
  .eae-home .card h3 { font-size: 19px; margin: 4px 0 6px; line-height: 1.3; }
  .eae-home .card p { font-size: 14.5px; margin: 0; color: #3b4741; }
  .eae-home .meta { font-size: 12.5px; color: #66706a; letter-spacing: .02em; }
  .eae-home .kind { display: inline-block; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #104b1f; margin-right: 8px; }
  .eae-home .lock { font-size: 12px; color: #8a6d1f; margin-left: 6px; }
  .eae-home .card.lead { grid-column: span 3; display: grid; grid-template-columns: 1.35fr 1fr; }
  .eae-home .card.lead img { aspect-ratio: auto; height: 100%; min-height: 300px; border-bottom: 0; border-right: 1px solid #eee; }
  .eae-home .card.lead .t { padding: 26px 28px; } .eae-home .card.lead h3 { font-size: 28px; } .eae-home .card.lead p { font-size: 16.5px; }

  .eae-home .row3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 8px; }
  .eae-home .row3 h2 { margin-top: 40px; font-size: 26px; }
  .eae-home .quick { list-style: none; margin: 0; padding: 0; border-top: 1px solid #e3e0d6; }
  .eae-home .quick li { margin: 0; padding: 9px 0; border-bottom: 1px solid #e3e0d6; font-size: 15px; line-height: 1.4; }
  .eae-home .quick li + li { margin: 0; }
  .eae-home .quick a { color: #1d2a24; text-decoration: none; } .eae-home .quick a:hover { color: #104b1f; text-decoration: underline; }
  .eae-home .quick .meta { display: block; margin-top: 2px; }

  .eae-home .about { margin-top: 56px; background: #f4f6f2; border-left: 4px solid #104b1f; padding: 22px 26px; border-radius: 0 8px 8px 0; }
  .eae-home .about h2 { margin-top: 0; font-size: 26px; }
  .eae-home .about p { max-width: 820px; margin: 0 0 10px; font-size: 16px; }
  .eae-home .about a { color: #104b1f; }

  @media (max-width: 980px) { .eae-home .dashes { grid-template-columns: repeat(3, minmax(0, 1fr)); } .eae-home .row3 { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .eae-home .cards { grid-template-columns: 1fr; } .eae-home .card.lead { grid-column: auto; grid-template-columns: 1fr; }
    .eae-home .card.lead img { min-height: 0; aspect-ratio: 16/10; border-right: 0; border-bottom: 1px solid #eee; }
    .eae-home .dashes { grid-template-columns: repeat(2, minmax(0, 1fr)); } .eae-home .intro p { font-size: 17px; }
  }
</style>

<main id="main" class="eae-home">

  <div class="intro">
    <p>Independent research on the economies and markets of Japan, Korea, Taiwan and China, from Taipei. Every major release, the cycle, and the themes that run across the region.</p>
    <div>
      {{#if @member}}
        {{#if @member.paid}}
          <a class="btn" href="/all/">Open the dashboards</a>
        {{else}}
          <a class="btn" href="/membership/">Your membership</a><a class="btn alt" href="#/portal/account/plans">Upgrade</a>
        {{/if}}
      {{else}}
        <a class="btn" href="#/portal/signup/free">Join free</a><a class="btn alt" href="/membership/">Plans</a>
      {{/if}}
    </div>
  </div>

  <h2>Live dashboards</h2>
  <p class="sub">The latest releases, our notes on them, and the headline indicators, updated every day. {{#unless @member.paid}}<a href="/membership/">From the Daily plan up</a>; free members get a taste.{{/unless}}</p>
  <div class="dashes">
    <a class="dash region" href="/all/"><b>Region</b><span>The four economies side by side, and US markets overnight</span></a>
    <a class="dash" href="/jp/"><b>Japan</b><span>BOJ, wages and prices, the yen and JGBs</span></a>
    <a class="dash" href="/kr/"><b>Korea</b><span>Exports, chips, the BOK and the won</span></a>
    <a class="dash" href="/tw/"><b>Taiwan</b><span>Orders, TSMC, the CBC and the TWD</span></a>
    <a class="dash" href="/cn/"><b>China</b><span>Activity, prices, credit and the PBC</span></a>
  </div>

  <h2><a href="/cycle/">Latest analysis</a><a class="more" href="/cycle/">Article archive →</a></h2>
  <p class="sub">Cycle notes on each release, plus Outlook and Thematic pieces.</p>
  <div class="cards">
  {{#get "posts" filter="tag:[hash-home,hash-jp,hash-cn,hash-kr,hash-tw,hash-all,hash-all-2]+tag:-hash-quick+tag:-hash-charts" limit="7" include="tags"}}
    {{#foreach posts}}
      <article class="card{{#if @first}} lead{{/if}}">
        {{#if feature_image}}<a href="{{url}}"><img src="{{img_url feature_image size="m"}}" alt="" loading="lazy"></a>{{/if}}
        <div class="t">
          <div class="meta"><span class="kind">{{#has tag="#thematic"}}Thematic{{else}}{{#has tag="#outlook"}}Outlook{{else}}{{#has tag="#slides"}}Slides{{else}}Cycle{{/has}}{{/has}}{{/has}}</span>{{date published_at format="D MMM YYYY"}}{{#has visibility="public"}}{{else}}<span class="lock">{{#has visibility="members"}}Members{{else}}Subscribers{{/has}}</span>{{/has}}</div>
          <a href="{{url}}"><h3>{{title}}</h3></a>
          <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="40"}}{{/if}}</p>
        </div>
      </article>
    {{/foreach}}
  {{/get}}
  </div>

  <div class="row3">
    <section>
      <h2><a href="/daily/">East Asia Today</a></h2>
      <p class="sub">Every weekday evening: the day's releases across the region.</p>
      {{#get "posts" filter="tag:hash-charts+slug:~'east-asia-today'" limit="1"}}{{#foreach posts}}
        <article class="card">
          {{#if feature_image}}<a href="{{url}}"><img src="{{img_url feature_image size="m"}}" alt="" loading="lazy"></a>{{/if}}
          <div class="t"><div class="meta">{{date published_at format="dddd D MMM"}}<span class="lock">Daily plan</span></div>
            <a href="{{url}}"><h3>{{title}}</h3></a>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}</div>
        </article>
      {{/foreach}}{{/get}}
      <p style="margin-top:10px"><a class="more" style="margin:0" href="/daily/">Daily archive →</a></p>
    </section>
    <section>
      <h2>East Asia in Four Charts</h2>
      <p class="sub">Every week, four charts on what matters. Free with membership.</p>
      {{#get "posts" filter="slug:~'east-asia-in-four-charts'" limit="1"}}{{#foreach posts}}
        <article class="card">
          {{#if feature_image}}<a href="{{url}}"><img src="{{img_url feature_image size="m"}}" alt="" loading="lazy"></a>{{/if}}
          <div class="t"><div class="meta">{{date published_at format="D MMM YYYY"}}</div>
            <a href="{{url}}"><h3>{{title}}</h3></a>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}</div>
        </article>
      {{/foreach}}{{/get}}
      <p style="margin-top:10px"><a class="more" style="margin:0" href="/membership/">Past issues →</a></p>
    </section>
    <section>
      <h2><a href="/quick/">Quick reactions</a></h2>
      <p class="sub">First takes on each release, as it comes out.</p>
      <ul class="quick">
      {{#get "posts" filter="tag:hash-quick" limit="8"}}{{#foreach posts}}
        <li><a href="{{url}}">{{title}}</a><span class="meta">{{date published_at format="D MMM, HH:mm"}}</span></li>
      {{/foreach}}{{/get}}
      </ul>
      <p style="margin-top:10px"><a class="more" style="margin:0" href="/quick/">All quick reactions →</a></p>
    </section>
  </div>

  <section class="about">
    <h2>About East Asia Econ</h2>
    <p>East Asia Econ is run from Taipei by Paul Cavey, drawing on thirty years of living and working in the region. The research rests on its own data infrastructure, built directly from official sources and published as live dashboards, interactive chart packs and a data API.</p>
    <p>Institutional subscriptions and trials: <a href="mailto:paul@eastasiaecon.com">paul@eastasiaecon.com</a>. Special access is available for academics.</p>
  </section>

</main>
